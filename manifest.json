{
  "manifest_version": 3,
  "name": "ASen — Seneca Study Helper",
  "version": "0.2.0",
  "description": "Reads visible lesson context and helps solve supported Seneca question formats locally.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.senecalearning.com/*",
    "https://senecalearning.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.senecalearning.com/*",
        "https://senecalearning.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
